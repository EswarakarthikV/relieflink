# =============================================================================
# ReliefLink Environment Variables Reference
# =============================================================================

# Client-Side Public Keys (Vite / Supabase)
# Safe for exposure in browser bundles. Protected by Supabase Row-Level Security (RLS).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Client-Side Public Web Push Key
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# =============================================================================
# Server-Side Private Secrets (Netlify Functions & Backend Scripts Only)
# DO NOT add the VITE_ prefix. These secrets are NEVER bundled into browser code.
# Configure these in Netlify Site Settings > Environment Variables:
# =============================================================================
SARVAM_API_KEY=your-sarvam-ai-api-key
GEMINI_API_KEY=your-gemini-api-key

# Server-Side Web Push Private Key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@relieflink.org

# Server-Side Webhook Secret (Protects /api/notify from unauthorized webhooks and broadcasts)
WEBHOOK_SECRET=your-webhook-secret-here

# Optional: Supabase Service Role Key for server-side administrative access
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

